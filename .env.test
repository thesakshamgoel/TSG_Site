# TEST-ONLY mode: force local mode (no auth gating) so the e2e suite can
# exercise form + console feedback paths in CI/headless without Firebase.
# (Blank VITE_FIREBASE_* values on their own no longer disable Firebase —
# they fall back to the built-in config, which keeps login working on hosts
# with half-filled env vars.)
VITE_FIREBASE_DISABLED=true
